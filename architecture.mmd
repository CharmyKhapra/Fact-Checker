graph TD

    %% ─── EXTERNAL AUTH ───────────────────────────────────────────
    subgraph EXT_AUTH["🔐 Auth0  (External)"]
        A0["Universal Login\n+ Token Issuer"]
    end

    %% ─── BROWSER ─────────────────────────────────────────────────
    subgraph BROWSER["🌐 Browser  —  Plain HTML / JS  (no build step)"]
        direction TB

        subgraph PAGES["Pages"]
            direction LR
            PG_LOGIN["login.html"]
            PG_INDEX["index.html\nDashboard"]
            PG_VERIFY["verify.html\nSubmit job"]
            PG_RESULTS["results.html\nReport viewer"]
            PG_OTHER["history · reports\nsources (static demo)"]
        end

        subgraph JS["Shared JS"]
            direction LR
            JS_SESSION["flens-session.js\nAuth guard · sidebar · logout"]
            JS_CONFIG["flens-config.js\nAuth0 credentials"]
            JS_APP["app.js\ndropzone · tabs · search"]
        end

        subgraph STORAGE["Browser Storage"]
            direction LR
            SS[("sessionStorage\nfactlensResult\nfactlensReturnTo")]
            LS[("localStorage\nAuth0 tokens")]
        end
    end

    %% ─── FASTAPI ─────────────────────────────────────────────────
    subgraph BACKEND["⚙️ FastAPI Server  —  Python  (port 8000)"]
        direction TB

        MAIN["main.py\nCORS · static mounts\n/media · /api/verify · /video"]

        subgraph ROUTES["API Routes  (routes/verify.py)"]
            direction LR
            RT["POST /text\nPOST /video\nPOST /video-url\nPOST /pdf\nPOST /pdf-url"]
        end

        subgraph APP["App Layer  (app/)"]
            direction LR
            EXTRACT["claim_extractor.py\nStructured JSON prompt\nmax 20 claims"]
            VERIFY_MOD["verifier.py\nBatch size = 4\nscore · summary · warnings"]
            GEM_CLI["gemini_client.py\ncall_json()\n_extract_json()\n_grounding_sources()\nRetry + backoff"]
            MODELS_PY["models.py\nClaim · VerificationResult\nReport · Verdict · Source"]
        end

        subgraph SVC["Services  (services/)"]
            direction LR
            TRANS["transcriber.py\ntranscribe_video()\nSRT as canonical format"]
            SRT["srt_utils.py\nsegments_to_srt()\nparse_srt()"]
            PDFEX["pdf_extractor.py\nextract_pdf()\nper-page text"]
            MAP["mapping.py\nattach_timestamps()\nattach_pages()\nSequenceMatcher fuzzy"]
        end

        subgraph FS["File System"]
            direction LR
            TEMP["backend/temp/\nupload staging"]
            MEDIA["backend/media/\npersisted videos\nserved at /media/"]
            OUT["backend/outputs/\nSRT files"]
        end

        CFG["config.py\nGEMINI_MODEL · API_KEY\nWHISPER_MODEL · DEVICE\nMAX_* limits · BATCH_SIZE"]
    end

    %% ─── LOCAL ML ────────────────────────────────────────────────
    subgraph LOCAL_ML["🖥️ Local ML  (no network call)"]
        direction LR
        WHISPER["Faster-Whisper\nlarge-v3-turbo\nCPU · int8 · VAD"]
        PYMUPDF["PyMuPDF\npage.get_text()"]
        YTDLP["yt-dlp\nYouTube · TikTok\nInstagram · X · Vimeo"]
    end

    %% ─── GEMINI ──────────────────────────────────────────────────
    subgraph GEMINI["☁️ Google Gemini API  (External)"]
        direction LR
        G_JSON["Structured JSON mode\nresponse_mime_type=json\n→ Claim Extraction"]
        G_WEB["Google Search grounded\ntools=[GoogleSearch()]\n→ Claim Verification"]
    end

    %% ══════════════════════════════════════════════════════════════
    %% EDGES
    %% ══════════════════════════════════════════════════════════════

    %% Auth
    JS_SESSION <-->|"isAuthenticated\ngetUser\nloginWithRedirect"| A0
    A0 -->|"redirect + code"| PG_LOGIN
    JS_SESSION <--> LS
    JS_CONFIG --> JS_SESSION

    %% Page wiring
    PG_VERIFY --> JS_APP
    PG_VERIFY <--> SS
    PG_RESULTS <--> SS
    PAGES --> JS_SESSION

    %% Browser → Backend
    PG_VERIFY -->|"POST FormData / multipart"| RT
    RT -->|"JSON report"| PG_VERIFY
    PG_RESULTS -->|"GET /media/uuid.mp4"| MEDIA

    %% FastAPI internals
    MAIN --> ROUTES
    MAIN --> CFG
    MAIN --> FS

    RT --> EXTRACT
    RT --> TRANS
    RT --> YTDLP
    RT --> PDFEX
    RT --> TEMP

    EXTRACT --> GEM_CLI
    VERIFY_MOD --> GEM_CLI
    EXTRACT --> VERIFY_MOD
    VERIFY_MOD --> MAP
    TRANS --> SRT
    TRANS --> WHISPER
    PDFEX --> PYMUPDF
    YTDLP -->|"downloaded MP4"| TRANS
    TEMP --> TRANS
    TEMP --> PDFEX
    SRT --> OUT
    TRANS --> OUT
    RT --> MEDIA

    MODELS_PY -.->|type definitions| EXTRACT
    MODELS_PY -.->|type definitions| VERIFY_MOD

    %% Gemini
    GEM_CLI -->|"json_object=True"| G_JSON
    GEM_CLI -->|"enable_web_search=True"| G_WEB
    G_JSON -->|"structured dict"| GEM_CLI
    G_WEB -->|"results + grounding URLs"| GEM_CLI

